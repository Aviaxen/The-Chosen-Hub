local function monitorEnemyDefeats(targetPlayer)
    if targetPlayer == LocalPlayer then return end
    
    targetPlayer.CharacterAdded:Connect(function(character)
        local humanoid = character:WaitForChild("Humanoid", 5)
        local rootPart = character:WaitForChild("HumanoidRootPart", 5)
        if not humanoid or not rootPart then return end
        
        humanoid.Died:Connect(function()
            local initialKills = getgenv().KillCount
            task.wait(0.05) 
            if getgenv().KillCount > initialKills then return end 
            
            local creatorTag = humanoid:FindFirstChild("creator") or humanoid:FindFirstChild("killer")
            if creatorTag and (creatorTag.Value == LocalPlayer or creatorTag.Value == LocalPlayer.Name) then
                updateKillUI(getgenv().KillCount + 1)
                return
            end
            
            if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
                local myRoot = LocalPlayer.Character.HumanoidRootPart
                local distance = (myRoot.Position - rootPart.Position).Magnitude
                if distance <= 12 then
                    updateKillUI(getgenv().KillCount + 1)
                end
            end
        end)
    end)
end

for _, player in ipairs(Players:GetPlayers()) do
    monitorEnemyDefeats(player)
end
Players.PlayerAdded:Connect(monitorEnemyDefeats)

