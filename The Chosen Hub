getgenv().AddPlayerTracers = function(player, character)
    if not TracerGui or player == LocalPlayer then return end
    
    local oldTracer = TracerGui:FindFirstChild(player.Name .. "_Tracer")
    if oldTracer then oldTracer:Destroy() end
    
    local humanoid = character:WaitForChild("Humanoid", 5)
    local head = character:FindFirstChild("Head") or character:FindFirstChildWhichIsA("BasePart")
    local rootPart = character:FindFirstChild("HumanoidRootPart") or (humanoid and humanoid.RootPart) or head
    if not rootPart then return end
    
    local tracerContainer = Instance.new("Frame")
    tracerContainer.Name = player.Name .. "_Tracer"
    tracerContainer.BackgroundTransparency = 1
    tracerContainer.Visible = false
    tracerContainer.Parent = TracerGui
    
    local shadowLine = Instance.new("Frame")
    shadowLine.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
    shadowLine.BackgroundTransparency = 0.4
    shadowLine.BorderSizePixel = 0
    shadowLine.AnchorPoint = Vector2.new(0.5, 0.5) 
    shadowLine.Parent = tracerContainer
    
    local mainLine = Instance.new("Frame")
    mainLine.BorderSizePixel = 0
    mainLine.AnchorPoint = Vector2.new(0.5, 0.5)  
    mainLine.Parent = tracerContainer
    
    local renderConnection
    renderConnection = RunService.RenderStepped:Connect(function()
        if not getgenv().EspEnabled or not character:IsDescendantOf(workspace) or not LocalPlayer.Character then
            tracerContainer:Destroy()
            renderConnection:Disconnect()
            return
        end
        
        local myRoot = LocalPlayer.Character:FindFirstChild("HumanoidRootPart") or LocalPlayer.Character:FindFirstChildWhichIsA("BasePart")
        if not myRoot or not rootPart:IsDescendantOf(workspace) then
            tracerContainer.Visible = false
            return
        end
        
        mainLine.BackgroundColor3 = getgenv().EspColor
        
        local _, size = character:GetBoundingBox()
        local feetWorldPosition = rootPart.Position - Vector3.new(0, (size.Y / 2), 0)
        local tracerPos, tracerOnScreen = Camera:WorldToViewportPoint(feetWorldPosition)
        
        if tracerOnScreen then
            local distance = (myRoot.Position - rootPart.Position).Magnitude
            
            if distance <= 1000 then
                local startX = Camera.ViewportSize.X / 2
                local startY = Camera.ViewportSize.Y
                
                local diffX = tracerPos.X - startX
                local diffY = tracerPos.Y - startY
                local tracerDistance = math.sqrt(diffX^2 + diffY^2)
                local angle = math.atan2(diffY, diffX)
                
                local midX = (startX + tracerPos.X) / 2
                local midY = (startY + tracerPos.Y) / 2
                
                mainLine.Size = UDim2.new(0, tracerDistance, 0, 1) 
                mainLine.Position = UDim2.new(0, midX, 0, midY)
                mainLine.Rotation = math.deg(angle)
                
                shadowLine.Size = UDim2.new(0, tracerDistance, 0, 2.5) 
                shadowLine.Position = UDim2.new(0, midX, 0, midY)
                shadowLine.Rotation = math.deg(angle)
                
                tracerContainer.Visible = true
            else
                tracerContainer.Visible = false
            end
        else
            tracerContainer.Visible = false
        end
    end)
end

