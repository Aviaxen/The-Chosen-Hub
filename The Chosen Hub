local function cleanupPlayer(player)
    local data = getgenv().ESPData[player]

    if not data then
        return
    end

    if data.RenderConnection then
        data.RenderConnection:Disconnect()
        data.RenderConnection = nil
    end

    if data.CharacterConnection then
        data.CharacterConnection:Disconnect()
        data.CharacterConnection = nil
    end

    if data.Highlight then
        data.Highlight:Destroy()
        data.Highlight = nil
    end

    if data.Billboard then
        data.Billboard:Destroy()
        data.Billboard = nil
    end

    if data.Box then
        data.Box:Destroy()
        data.Box = nil
    end

    if data.Tracer then
        data.Tracer:Destroy()
        data.Tracer = nil
    end

    getgenv().ESPData[player] = nil
end

local function createESP(player, character)
    if player == LocalPlayer then
        return
    end

    if not getgenv().EspEnabled then
        return
    end

    if not character then
        return
    end

    local humanoid = character:WaitForChild("Humanoid", 10)

    if not humanoid then
        return
    end

    local rootPart = character:WaitForChild("HumanoidRootPart", 10)

    if not rootPart then
        return
    end

    local head = character:FindFirstChild("Head")

    if not head then
        head = character:WaitForChild("Head", 5)
    end

    if not head then
        return
    end

    if player.Character ~= character then
        return
    end

    cleanupPlayer(player)

    local data = {
        Character = character,
        Highlight = nil,
        Billboard = nil,
        Box = nil,
        Tracer = nil,
        RenderConnection = nil
    }

    getgenv().ESPData[player] = data

    local highlight = Instance.new("Highlight")
    highlight.Name = "ESPHighlight"
    highlight.Adornee = character
    highlight.FillColor = getgenv().EspColor
    highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
    highlight.FillTransparency = 0.5
    highlight.OutlineTransparency = 0
    highlight.Enabled = true
    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    highlight.Parent = character

    data.Highlight = highlight

    local billboard = Instance.new("BillboardGui")
    billboard.Name = "ESPNameTag"
    billboard.Size = UDim2.new(0, 200, 0, 50)
    billboard.StudsOffset = Vector3.new(0, 3.5, 0)
    billboard.AlwaysOnTop = true
    billboard.Adornee = head
    billboard.Enabled = true
    billboard.Parent = character

    data.Billboard = billboard

    local layout = Instance.new("UIListLayout")
    layout.SortOrder = Enum.SortOrder.LayoutOrder
    layout.Padding = UDim.new(0, 2)
    layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
    layout.VerticalAlignment = Enum.VerticalAlignment.Center
    layout.Parent = billboard

    local nameLabel = Instance.new("TextLabel")
    nameLabel.Size = UDim2.new(1, 0, 0, 18)
    nameLabel.BackgroundTransparency = 1
    nameLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
    nameLabel.TextSize = 13
    nameLabel.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
    nameLabel.TextStrokeTransparency = 0
    nameLabel.Font = Enum.Font.SourceSansBold
    nameLabel.Text = player.Name
    nameLabel.LayoutOrder = 1
    nameLabel.Parent = billboard

    local distLabel = Instance.new("TextLabel")
    distLabel.Size = UDim2.new(1, 0, 0, 16)
    distLabel.BackgroundTransparency = 1
    distLabel.TextColor3 = Color3.fromRGB(230, 230, 230)
    distLabel.TextSize = 12
    distLabel.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
    distLabel.TextStrokeTransparency = 0
    distLabel.Font = Enum.Font.SourceSansBold
    distLabel.Text = "[0 studs]"
    distLabel.LayoutOrder = 2
    distLabel.Parent = billboard

    local box = Instance.new("Frame")
    box.Name = player.Name .. "_2DBox"
    box.BackgroundTransparency = 1
    box.Size = UDim2.new(0, 100, 0, 100)
    box.Visible = false
    box.Parent = EspGui

    data.Box = box

    local stroke = Instance.new("UIStroke")
    stroke.Thickness = 1.5
    stroke.Color = getgenv().EspColor
    stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    stroke.Parent = box

    local shadowStroke = Instance.new("UIStroke")
    shadowStroke.Thickness = 2.5
    shadowStroke.Color = Color3.fromRGB(0, 0, 0)
    shadowStroke.Transparency = 0.6
    shadowStroke.Parent = box

    local tracer = Instance.new("Frame")
    tracer.Name = player.Name .. "_Tracer"
    tracer.BackgroundTransparency = 1
    tracer.Visible = false
    tracer.Parent = TracerGui

    data.Tracer = tracer

    local shadowLine = Instance.new("Frame")
    shadowLine.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
    shadowLine.BackgroundTransparency = 0.4
    shadowLine.BorderSizePixel = 0
    shadowLine.AnchorPoint = Vector2.new(0.5, 0.5)
    shadowLine.Parent = tracer

    local mainLine = Instance.new("Frame")
    mainLine.BackgroundColor3 = getgenv().EspColor
    mainLine.BorderSizePixel = 0
    mainLine.AnchorPoint = Vector2.new(0.5, 0.5)
    mainLine.Parent = tracer

    data.RenderConnection = RunService.RenderStepped:Connect(function()
        if not getgenv().EspEnabled then
            box.Visible = false
            tracer.Visible = false
            billboard.Enabled = false
            return
        end

        if player.Character ~= character
            or not character:IsDescendantOf(workspace)
            or not rootPart:IsDescendantOf(workspace)
        then
            box.Visible = false
            tracer.Visible = false
            billboard.Enabled = false
            return
        end

        local myCharacter = LocalPlayer.Character

        if not myCharacter then
            box.Visible = false
            tracer.Visible = false
            return
        end

        local myRoot = myCharacter:FindFirstChild("HumanoidRootPart")

        if not myRoot then
            box.Visible = false
            tracer.Visible = false
            return
        end

        local Camera = getCamera()

        if not Camera then
            return
        end

        highlight.FillColor = getgenv().EspColor
        stroke.Color = getgenv().EspColor
        mainLine.BackgroundColor3 = getgenv().EspColor

        local distance = (myRoot.Position - rootPart.Position).Magnitude
        distLabel.Text = "[" .. math.floor(distance) .. " studs]"

        highlight.Enabled = true

        local rootPos, onScreen = Camera:WorldToViewportPoint(rootPart.Position)

        if onScreen and distance <= 1000 then
            local _, size = character:GetBoundingBox()

            local topPos = Camera:WorldToViewportPoint(
                rootPart.Position + Vector3.new(0, size.Y / 2, 0)
            )

            local bottomPos = Camera:WorldToViewportPoint(
                rootPart.Position - Vector3.new(0, size.Y / 2, 0)
            )

            local boxHeight = math.abs(topPos.Y - bottomPos.Y)
            local boxWidth = boxHeight * 0.65

            box.Size = UDim2.new(0, boxWidth, 0, boxHeight)

            box.Position = UDim2.new(
                0,
                rootPos.X - boxWidth / 2,
                0,
                rootPos.Y - boxHeight / 2
            )

            box.Visible = true
            billboard.Enabled = true

            local feetWorldPosition =
                rootPart.Position - Vector3.new(0, size.Y / 2, 0)

            local tracerPos, tracerOnScreen =
                Camera:WorldToViewportPoint(feetWorldPosition)

            if tracerOnScreen then
                local startX = Camera.ViewportSize.X / 2
                local startY = Camera.ViewportSize.Y

                local diffX = tracerPos.X - startX
                local diffY = tracerPos.Y - startY

                local tracerDistance =
                    math.sqrt(diffX^2 + diffY^2)

                local angle = math.atan2(diffY, diffX)

                local midX = (startX + tracerPos.X) / 2
                local midY = (startY + tracerPos.Y) / 2

                mainLine.Size =
                    UDim2.new(0, tracerDistance, 0, 1)

                mainLine.Position =
                    UDim2.new(0, midX, 0, midY)

                mainLine.Rotation = math.deg(angle)

                shadowLine.Size =
                    UDim2.new(0, tracerDistance, 0, 2.5)

                shadowLine.Position =
                    UDim2.new(0, midX, 0, midY)

                shadowLine.Rotation = math.deg(angle)

                tracer.Visible = true
            else
                tracer.Visible = false
            end
        else
            box.Visible = false
            tracer.Visible = false
            billboard.Enabled = true
        end
    end)
end

local function setupPlayer(player)
    if player == LocalPlayer then
        return
    end

    local oldData = getgenv().ESPData[player]

    if oldData and oldData.CharacterConnection then
        oldData.CharacterConnection:Disconnect()
        oldData.CharacterConnection = nil
    end

    local function onCharacterAdded(character)
        local humanoid = character:WaitForChild("Humanoid", 10)
        local root = character:WaitForChild("HumanoidRootPart", 10)

        if not humanoid or not root then
            return
        end

        task.wait(0.25)

        if player.Character ~= character then
            return
        end

        if getgenv().EspEnabled then
            createESP(player, character)
        end
    end

    if player.Character then
        task.spawn(onCharacterAdded, player.Character)
    end

    local connection = player.CharacterAdded:Connect(onCharacterAdded)

    if not getgenv().ESPData[player] then
        getgenv().ESPData[player] = {}
    end

    getgenv().ESPData[player].CharacterConnection = connection
end

