local function addEsp(player)
    if player == LocalPlayer then return end
    
    local function applyHighlight(character)
        if not character then return end
        
        if character:FindFirstChild("ESPHighlight") then character.ESPHighlight:Destroy() end
        if character:FindFirstChild("ESPNameTag") then character.ESPNameTag:Destroy() end
        
        local oldBox = EspGui:FindFirstChild(player.Name .. "_2DBox")
        if oldBox then oldBox:Destroy() end
        
        local humanoid = character:WaitForChild("Humanoid", 5)
        local head = character:FindFirstChild("Head") or character:FindFirstChildWhichIsA("BasePart")
        local rootPart = character:FindFirstChild("HumanoidRootPart") or (humanoid and humanoid.RootPart) or head
        
        if not rootPart or not head then return end
        
        local highlight = Instance.new("Highlight")
        highlight.Name = "ESPHighlight"
        highlight.FillColor = getgenv().EspColor            
        highlight.OutlineColor = Color3.fromRGB(255, 255, 255) 
        highlight.FillTransparency = 0.5                      
        highlight.OutlineTransparency = 0                     
        highlight.Adornee = character
        highlight.Parent = character
        
        local billboard = Instance.new("BillboardGui")
        billboard.Name = "ESPNameTag"
        billboard.Size = UDim2.new(0, 200, 0, 60)             
        billboard.StudsOffset = Vector3.new(0, 3, 0)          
        billboard.AlwaysOnTop = true                          
        billboard.Adornee = head
        billboard.Parent = character
        
        local label = Instance.new("TextLabel")
        label.Size = UDim2.new(1, 0, 1, 0)
        label.BackgroundTransparency = 1                      
        label.TextColor3 = Color3.fromRGB(255, 255, 255)      
        label.TextSize = 14                                   
        label.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)      
        label.TextStrokeTransparency = 0                      
        label.Font = Enum.Font.SourceSansBold                 
        label.TextYAlignment = Enum.TextYAlignment.Center     
        label.Parent = billboard
        
        local boxContainer = Instance.new("Frame")
        boxContainer.Name = player.Name .. "_2DBox"
        boxContainer.BackgroundTransparency = 1
        boxContainer.Size = UDim2.new(0, 100, 0, 100)
        boxContainer.Visible = false
        boxContainer.Parent = EspGui
        
        local stroke = Instance.new("UIStroke")
        stroke.Thickness = 1.5
        stroke.Color = getgenv().EspColor
        stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
        stroke.Parent = boxContainer
        
        local strokeInline = Instance.new("UIStroke")
        strokeInline.Thickness = 2.5
        strokeInline.Color = Color3.fromRGB(0, 0, 0)
        strokeInline.Transparency = 0.6
        strokeInline.Parent = boxContainer
        
        local renderConnection
        renderConnection = RunService.RenderStepped:Connect(function()
            if not getgenv().EspEnabled or not character:IsDescendantOf(workspace) or not LocalPlayer.Character then
                boxContainer:Destroy()
                renderConnection:Disconnect()
                return
            end
            
            local myRoot = LocalPlayer.Character:FindFirstChild("HumanoidRootPart") or LocalPlayer.Character:FindFirstChildWhichIsA("BasePart")
            if not myRoot or not rootPart:IsDescendantOf(workspace) then 
                boxContainer.Visible = false
                return 
            end
            
            highlight.FillColor = getgenv().EspColor
            stroke.Color = getgenv().EspColor
            
            local rootPos, onScreen = Camera:WorldToViewportPoint(rootPart.Position)
            
            if onScreen then
                local myPos = myRoot.Position
                local theirPos = rootPart.Position
                local distance = math.floor((myPos - theirPos).Magnitude)
                
                if distance <= 1000 then
                    local _, size = character:GetBoundingBox()
                    
                    local topPos = Camera:WorldToViewportPoint(rootPart.Position + Vector3.new(0, size.Y / 2, 0))
                    local bottomPos = Camera:WorldToViewportPoint(rootPart.Position - Vector3.new(0, size.Y / 2, 0))
                    
                    local boxHeight = math.abs(topPos.Y - bottomPos.Y)
                    local boxWidth = boxHeight * 0.65 
                    
                    boxContainer.Size = UDim2.new(0, boxWidth, 0, boxHeight)
                    boxContainer.Position = UDim2.new(0, rootPos.X - (boxWidth / 2), 0, rootPos.Y - (boxHeight / 2))
                    
                    highlight.Enabled = true
                    boxContainer.Visible = true
                    billboard.Enabled = true
                    label.Text = player.Name .. "\n[" .. distance .. " studs]"
                else
                    highlight.Enabled = false
                    boxContainer.Visible = false
                    billboard.Enabled = false
                end
            else
                boxContainer.Visible = false
            end
        end)
    end

    if player.Character then
        task.spawn(applyHighlight, player.Character)
    end
    player.CharacterAdded:Connect(applyHighlight)
end

