getgenv().FlyEnabled = false
getgenv().FlySpeed = 50 

local flyConnection
local bodyVelocity
local bodyGyro

local function startFlying()
    local character = LocalPlayer.Character
    if not character then return end
    local rootPart = character:WaitForChild("HumanoidRootPart", 5)
    local humanoid = character:WaitForChild("Humanoid", 5)
    if not rootPart or not humanoid then return end
    
    humanoid.PlatformStand = true
    
    bodyGyro = Instance.new("BodyGyro")
    bodyGyro.P = 9e4
    bodyGyro.maxTorque = Vector3.new(9e9, 9e9, 9e9)
    bodyGyro.cframe = rootPart.CFrame
    bodyGyro.Parent = rootPart

    bodyVelocity = Instance.new("BodyVelocity")
    bodyVelocity.velocity = Vector3.new(0, 0, 0)
    bodyVelocity.maxForce = Vector3.new(9e9, 9e9, 9e9)
    bodyVelocity.Parent = rootPart
    
    flyConnection = RunService.RenderStepped:Connect(function()
        if not getgenv().FlyEnabled or not character:IsDescendantOf(workspace) or not rootPart then
            if flyConnection then flyConnection:Disconnect() end
            return
        end

        local camera = workspace.CurrentCamera
        local moveDirection = humanoid.MoveDirection
        
        local targetVelocity = Vector3.new(0, 0, 0)

        if moveDirection.Magnitude > 0 then
            local lookVector = camera.CFrame.LookVector
            
            local flatLook = Vector3.new(lookVector.X, 0, lookVector.Z).Unit
            local rightVector = camera.CFrame.RightVector
            local flatRight = Vector3.new(rightVector.X, 0, rightVector.Z).Unit
            
            local forwardDot = moveDirection:Dot(flatLook)
            local rightDot = moveDirection:Dot(flatRight)
            
            local forwardComponent = lookVector * forwardDot
            local sidewaysComponent = flatRight * rightDot
            
            targetVelocity = (forwardComponent + sidewaysComponent).Unit * getgenv().FlySpeed
        end
        
        bodyGyro.cframe = camera.CFrame
        bodyVelocity.velocity = targetVelocity
    end)
end

local function stopFlying()
    if flyConnection then
        flyConnection:Disconnect()
        flyConnection = nil
    end
    if bodyVelocity then bodyVelocity:Destroy() end
    if bodyGyro then bodyGyro:Destroy() end
    
    local character = LocalPlayer.Character
    if character then
        local humanoid = character:FindFirstChild("Humanoid")
        if humanoid then
            humanoid.PlatformStand = false
        end
    end
end

LocalPlayer.CharacterAdded:Connect(function(char)
    task.wait(0.5)
    if getgenv().FlyEnabled then
        startFlying()
    end
end)

