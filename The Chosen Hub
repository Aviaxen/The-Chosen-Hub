local function cleanupPlayer(player)
    if not player then
        return
    end

    local id = player.UserId
    local data = getgenv().ESPPlayers[id]

    if data then
        if data.Highlight then
            pcall(function()
                data.Highlight.Enabled = false
                data.Highlight:Destroy()
            end)
        end

        if data.Billboard then
            pcall(function()
                data.Billboard:Destroy()
            end)
        end

        if data.Box then
            pcall(function()
                data.Box:Destroy()
            end)
        end

        if data.Tracer then
            pcall(function()
                data.Tracer:Destroy()
            end)
        end

        getgenv().ESPPlayers[id] = nil
    end
    
    if EspGui then
        local box = EspGui:FindFirstChild(tostring(id) .. "_2DBox")
        if box then
            box:Destroy()
        end
    end

    if TracerGui then
        local tracer = TracerGui:FindFirstChild(tostring(id) .. "_Tracer")
        if tracer then
            tracer:Destroy()
        end
    end
end

