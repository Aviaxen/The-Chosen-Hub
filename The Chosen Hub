local function updateKillUI(newAmount)
    getgenv().KillCount = newAmount
    killStat:Set(getgenv().KillCount)
end

-- ==========================================
-- LAYER 1: UNIVERSAL LEADERSTATS MONITOR
-- ==========================================
local function trackLeaderstats(leaderstats)
    local killKeywords = {"kills", "kos", "wipeouts", "knockouts", "frags", "defeats", "streaks"}
    
    local function checkValue(child)
        if child:IsA("ValueBase") then
            local childName = child.Name:lower()
            for _, keyword in ipairs(killKeywords) do
                if childName:find(keyword) then
                    child.Changed:Connect(function(newValue)
                        if newValue > getgenv().KillCount then
                            updateKillUI(newValue)
                        end
                    end)
                    if child.Value > getgenv().KillCount then
                        updateKillUI(child.Value)
                    end
                    break
                end
            end
        end
    end

    for _, child in ipairs(leaderstats:GetChildren()) do
        checkValue(child)
    end
    leaderstats.ChildAdded:Connect(checkValue)
end

local function setupLocalPlayerStats()
    local leaderstats = LocalPlayer:WaitForChild("leaderstats", 5)
    if leaderstats then
        trackLeaderstats(leaderstats)
    else
        LocalPlayer.ChildAdded:Connect(function(child)
            if child.Name == "leaderstats" then
                trackLeaderstats(child)
            end
        end)
    end
end
task.spawn(setupLocalPlayerStats)

-- ==========================================
-- LAYER 2 & 3: TAGS & PROXIMITY ENGINE
-- ==========================================
local function monitorEnemyDefeats(targetPlayer)
    if targetPlayer == LocalPlayer then return end
    
    targetPlayer.CharacterAdded:Connect(function(character)
        local humanoid = character:WaitForChild("Humanoid", 5)
        local rootPart = character:WaitForChild("HumanoidRootPart", 5)
        if not humanoid or not rootPart then return end
        
        humanoid.Died:Connect(function()
            local initialKills = getgenv().KillCount
            task.wait(0.05) 
            if getgenv().KillCount > initialKills then return end 
            
            -- Classic Creator Tag Checking
            local creatorTag = humanoid:FindFirstChild("creator") or humanoid:FindFirstChild("killer")
            if creatorTag and (creatorTag.Value == LocalPlayer or creatorTag.Value == LocalPlayer.Name) then
                updateKillUI(getgenv().KillCount + 1)
                return
            end
            
            -- Proximity Combat Fallback Check
            if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
                local myRoot = LocalPlayer.Character.HumanoidRootPart
                local distance = (myRoot.Position - rootPart.Position).Magnitude
                if distance <= 12 then
                    updateKillUI(getgenv().KillCount + 1)
                end
            end
        end)
    end)
end

for _, player in ipairs(Players:GetPlayers()) do
    monitorEnemyDefeats(player)
end
Players.PlayerAdded:Connect(monitorEnemyDefeats)



