local function trackLeaderstats(leaderstats)
    local killKeywords = {"kills", "kos", "wipeouts", "knockouts", "frags", "defeats", "streaks"}
    
    local function checkValue(child)
        if child:IsA("ValueBase") then
            local childName = child.Name:lower()
            for _, keyword in ipairs(killKeywords) do
                if childName:find(keyword) then
                    child.Changed:Connect(function(newValue)
                        if newValue > getgenv().KillCount then
                            updateKillUI(newValue)
                        end
                    end)
                    if child.Value > getgenv().KillCount then
                        updateKillUI(child.Value)
                    end
                    break
                end
            end
        end
    end

    for _, child in ipairs(leaderstats:GetChildren()) do
        checkValue(child)
    end
    leaderstats.ChildAdded:Connect(checkValue)
end

local function setupLocalPlayerStats()
    local leaderstats = LocalPlayer:WaitForChild("leaderstats", 5)
    if leaderstats then
        trackLeaderstats(leaderstats)
    else
        LocalPlayer.ChildAdded:Connect(function(child)
            if child.Name == "leaderstats" then
                trackLeaderstats(child)
            end
        end)
    end
end
