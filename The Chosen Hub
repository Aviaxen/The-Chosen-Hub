local function addChams(player)
    if player == LocalPlayer then return end
    
    if ChamsConnections[player.Name] then
        ChamsConnections[player.Name]:Disconnect()
        ChamsConnections[player.Name] = nil
    end
    
    local function applyChams(character)
        if not character then return end
        
        if character:FindFirstChild("SoloChamsHighlight") then 
            character.SoloChamsHighlight:Destroy() 
        end
        
        local humanoid = character:WaitForChild("Humanoid", 5)
        local head = character:FindFirstChild("Head") or character:FindFirstChildWhichIsA("BasePart")
        local rootPart = character:FindFirstChild("HumanoidRootPart") or (humanoid and humanoid.RootPart) or head
        if not rootPart then return end
        
        local highlight = Instance.new("Highlight")
        highlight.Name = "SoloChamsHighlight"
        highlight.FillColor = getgenv().ChamsColor            
        highlight.OutlineColor = Color3.fromRGB(255, 255, 255) 
        highlight.FillTransparency = 0.5                      
        highlight.OutlineTransparency = 0                     
        highlight.Adornee = character
        highlight.Parent = character
        highlight.Enabled = false 
        
        ChamsTargets[player.Name] = {
            Highlight = highlight,
            Root = rootPart,
            Distance = 99999
        }
    end
    
    if player.Character then task.spawn(applyChams, player.Character) end
    ChamsConnections[player.Name] = player.CharacterAdded:Connect(applyChams)
end

local function refreshAllChams()
    if not getgenv().ChamsEnabled then return end
    ChamsTargets = {}
    
