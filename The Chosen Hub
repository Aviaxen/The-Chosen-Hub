local function setupPlayer(player)
    if player == LocalPlayer then
        return
    end
    
    cleanupPlayer(player)

    local function characterAdded(character)
        task.spawn(function()
            local humanoid =
                character:FindFirstChildOfClass("Humanoid")
                or character:WaitForChild("Humanoid", 5)

            if not humanoid then
                return
            end
            
            local root =
                character:FindFirstChild("HumanoidRootPart")
                or character:WaitForChild("HumanoidRootPart", 5)

            local head =
                character:FindFirstChild("Head")
                or character:WaitForChild("Head", 5)

            if not character:IsDescendantOf(workspace) then
                return
            end

            if humanoid.Health <= 0 then
                return
            end

            -- Small delay prevents race conditions during respawn
            task.wait()

            if not character:IsDescendantOf(workspace) then
                return
            end

            if humanoid.Health <= 0 then
                return
            end

            createESP(player, character)
        end)
    end
    
    if player.Character then
        characterAdded(player.Character)
    end
    
    player.CharacterAdded:Connect(characterAdded)
end

getgenv().ESPMainConnection = RunService.RenderStepped:Connect(function()
    local camera = workspace.CurrentCamera

    if not camera then
        return
    end

    if not getgenv().EspEnabled then
        for _, data in pairs(getgenv().ESPPlayers) do
            if data.Highlight then
                data.Highlight.Enabled = false
            end

            if data.Box then
                data.Box.Visible = false
            end

            if data.Billboard then
                data.Billboard.Enabled = false
            end

            if data.Tracer then
                data.Tracer.Visible = false
            end
        end

        return
    end

    local localCharacter = LocalPlayer.Character

    if not localCharacter then
        return
    end

    local myRoot =
        localCharacter:FindFirstChild("HumanoidRootPart")
        or localCharacter:FindFirstChildWhichIsA("BasePart")

    if not myRoot then
        return
    end

    local targets = {}

    for id, data in pairs(getgenv().ESPPlayers) do
        local player = data.Player
        local character = data.Character
        local humanoid = data.Humanoid
        local rootPart = data.RootPart
        
        if not player
            or not player.Parent
            or not character
            or not character:IsDescendantOf(workspace)
            or not humanoid
            or not rootPart
            or not rootPart:IsDescendantOf(workspace) then

            if data.Highlight then
                data.Highlight.Enabled = false
            end

            if data.Box then
                data.Box.Visible = false
            end

            if data.Billboard then
                data.Billboard.Enabled = false
            end

            if data.Tracer then
                data.Tracer.Visible = false
            end

            data.Alive = false
            data.Distance = math.huge

            continue
        end

        if humanoid.Health <= 0 then
            data.Alive = false
            data.Distance = math.huge

            data.Highlight.Enabled = false
            data.Box.Visible = false
            data.Billboard.Enabled = false
            data.Tracer.Visible = false

            continue
        end

        data.Alive = true

        local distance =
            (myRoot.Position - rootPart.Position).Magnitude

        data.Distance = distance
        
        data.Highlight.FillColor = getgenv().EspColor
        data.Stroke.Color = getgenv().EspColor
        data.MainLine.BackgroundColor3 = getgenv().EspColor

        local rootPosition, onScreen =
            camera:WorldToViewportPoint(rootPart.Position)

        if not onScreen or distance > MAX_DISTANCE then
            data.Box.Visible = false
            data.Billboard.Enabled = false
            data.Tracer.Visible = false

            continue
        end

        local success, _, size = pcall(function()
            return character:GetBoundingBox()
        end)

        if success and size then
            local topPosition =
                camera:WorldToViewportPoint(
                    rootPart.Position + Vector3.new(0, size.Y / 2, 0)
                )

            local bottomPosition =
                camera:WorldToViewportPoint(
                    rootPart.Position - Vector3.new(0, size.Y / 2, 0)
                )

            local boxHeight =
                math.abs(topPosition.Y - bottomPosition.Y)

            local boxWidth =
                boxHeight * 0.65

            if boxHeight > 1 then
                data.Box.Size =
                    UDim2.new(0, boxWidth, 0, boxHeight)

                data.Box.Position =
                    UDim2.new(
                        0,
                        rootPosition.X - boxWidth / 2,
                        0,
                        rootPosition.Y - boxHeight / 2
                    )

                data.Box.Visible = true
            else
                data.Box.Visible = false
            end

            data.DistanceLabel.Text =
                "[" .. math.floor(distance) .. " studs]"

            data.Billboard.Enabled = true

            local feetPosition =
                rootPart.Position - Vector3.new(0, size.Y / 2, 0)

            local tracerPosition, tracerOnScreen =
                camera:WorldToViewportPoint(feetPosition)

            if tracerOnScreen then
                local startX =
                    camera.ViewportSize.X / 2

                local startY =
                    camera.ViewportSize.Y

                local diffX =
                    tracerPosition.X - startX

                local diffY =
                    tracerPosition.Y - startY

                local lineDistance =
                    math.sqrt(diffX ^ 2 + diffY ^ 2)

                local angle =
                    math.atan2(diffY, diffX)

                local midX =
                    (startX + tracerPosition.X) / 2

                local midY =
                    (startY + tracerPosition.Y) / 2

                data.MainLine.Size =
                    UDim2.new(0, lineDistance, 0, 1)

                data.MainLine.Position =
                    UDim2.new(0, midX, 0, midY)

                data.MainLine.Rotation =
                    math.deg(angle)

                data.ShadowLine.Size =
                    UDim2.new(0, lineDistance, 0, 2.5)

                data.ShadowLine.Position =
                    UDim2.new(0, midX, 0, midY)

                data.ShadowLine.Rotation =
                    math.deg(angle)

                data.Tracer.Visible = true
            else
                data.Tracer.Visible = false
            end
            
            table.insert(targets, data)
        end
    end

    table.sort(targets, function(a, b)
        return a.Distance < b.Distance
    end)

    for index, data in ipairs(targets) do
    if data.Alive
        and data.Humanoid
        and data.Humanoid.Health > 0
        and data.Distance <= MAX_DISTANCE then

        data.Highlight.Enabled = true
    else
        data.Highlight.Enabled = false
    end
end

