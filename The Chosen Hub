    local humanoid = character:WaitForChild("Humanoid", 5)
    local head = character:FindFirstChild("Head") or character:FindFirstChildWhichIsA("BasePart")
    local rootPart = character:FindFirstChild("HumanoidRootPart") or (humanoid and humanoid.RootPart) or head
    if not rootPart or not head then return end
    
    -- Create Chams
    local highlight = Instance.new("Highlight")
    highlight.Name = "ESPHighlight"
    highlight.FillColor = getgenv().EspColor            
    highlight.OutlineColor = Color3.fromRGB(255, 255, 255) 
    highlight.FillTransparency = 0.5                      
    highlight.OutlineTransparency = 0                     
    highlight.Adornee = character
    highlight.Parent = character
    highlight.Enabled = false 
    
    -- Create an expanded 3D text billboard layer
    local billboard = Instance.new("BillboardGui")
    billboard.Name = "ESPNameTag"
    billboard.Size = UDim2.new(0, 200, 0, 70)             
    billboard.StudsOffset = Vector3.new(0, 3.5, 0)          
    billboard.AlwaysOnTop = true                          
    billboard.Adornee = head
    billboard.Parent = character
    
    -- TEXT FIX: Use a vertical stack grid layout to hold rows separate
    local listLayout = Instance.new("UIListLayout")
    listLayout.SortOrder = Enum.SortOrder.LayoutOrder
    listLayout.Padding = UDim.new(0, 2) -- Forced 2-pixel gap between rows
    listLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center
    listLayout.VerticalAlignment = Enum.VerticalAlignment.Center
    listLayout.Parent = billboard
    
    -- Row 1: The Username String
    local nameLabel = Instance.new("TextLabel")
    nameLabel.Size = UDim2.new(1, 0, 0, 18)
    nameLabel.BackgroundTransparency = 1                      
    nameLabel.TextColor3 = Color3.fromRGB(255, 255, 255)      
    nameLabel.TextSize = 13                                   
    nameLabel.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)      
    nameLabel.TextStrokeTransparency = 0                      
    nameLabel.Font = Enum.Font.SourceSansBold                 
    nameLabel.Text = player.Name
    nameLabel.LayoutOrder = 1
    nameLabel.Parent = billboard
    
    -- Row 2: The Distance String
    local distLabel = Instance.new("TextLabel")
    distLabel.Size = UDim2.new(1, 0, 0, 16)
    distLabel.BackgroundTransparency = 1                      
    distLabel.TextColor3 = Color3.fromRGB(230, 230, 230)      
    distLabel.TextSize = 12                                   
    distLabel.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)      
    distLabel.TextStrokeTransparency = 0                      
    distLabel.Font = Enum.Font.SourceSansBold                 
    distLabel.LayoutOrder = 2
    distLabel.Parent = billboard
    
    -- Create 2D Overlay Box
    local boxContainer = Instance.new("Frame")
    boxContainer.Name = player.Name .. "_2DBox"
    boxContainer.BackgroundTransparency = 1
    boxContainer.Size = UDim2.new(0, 100, 0, 100)
    boxContainer.Visible = false
    boxContainer.Parent = EspGui
    
    local stroke = Instance.new("UIStroke")
    stroke.Thickness = 1.5
    stroke.Color = getgenv().EspColor
    stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    stroke.Parent = boxContainer
    
    local strokeInline = Instance.new("UIStroke")
    strokeInline.Thickness = 2.5
    strokeInline.Color = Color3.fromRGB(0, 0, 0)
    strokeInline.Transparency = 0.6
    strokeInline.Parent = boxContainer
    
    getgenv().ActiveTargets[player.Name] = {
        Highlight = highlight,
        Distance = 99999
    }
    
    local renderConnection
    renderConnection = RunService.RenderStepped:Connect(function()
        if not getgenv().EspEnabled or not character:IsDescendantOf(workspace) or not LocalPlayer.Character then
            boxContainer:Destroy()
            getgenv().ActiveTargets[player.Name] = nil
            renderConnection:Disconnect()
            return
        end
        
        local myRoot = LocalPlayer.Character:FindFirstChild("HumanoidRootPart") or LocalPlayer.Character:FindFirstChildWhichIsA("BasePart")
        if not myRoot or not rootPart:IsDescendantOf(workspace) then 
            boxContainer.Visible = false
            if getgenv().ActiveTargets[player.Name] then getgenv().ActiveTargets[player.Name].Distance = 99999 end
            return 
            end
        
        highlight.FillColor = getgenv().EspColor
        stroke.Color = getgenv().EspColor
        
        local rootPos, onScreen = Camera:WorldToViewportPoint(rootPart.Position)
        
        if onScreen then
            local distance = math.floor((myRoot.Position - rootPart.Position).Magnitude)
            if getgenv().ActiveTargets[player.Name] then getgenv().ActiveTargets[player.Name].Distance = distance end
            
            if distance <= 1000 then
                local _, size = character:GetBoundingBox()
                local topPos = Camera:WorldToViewportPoint(rootPart.Position + Vector3.new(0, size.Y / 2, 0))
                local bottomPos = Camera:WorldToViewportPoint(rootPart.Position - Vector3.new(0, size.Y / 2, 0))
                
                local boxHeight = math.abs(topPos.Y - bottomPos.Y)
                local boxWidth = boxHeight * 0.65 
                
                boxContainer.Size = UDim2.new(0, boxWidth, 0, boxHeight)
                boxContainer.Position = UDim2.new(0, rootPos.X - (boxWidth / 2), 0, rootPos.Y - (boxHeight / 2))
                
                boxContainer.Visible = true
                billboard.Enabled = true
                distLabel.Text = "[" .. distance .. " studs]"
            else
                boxContainer.Visible = false
                billboard.Enabled = false
                if getgenv().ActiveTargets[player.Name] then getgenv().ActiveTargets[player.Name].Distance = 99999 end
            end
        else
            boxContainer.Visible = false
            if getgenv().ActiveTargets[player.Name] then getgenv().ActiveTargets[player.Name].Distance = 99999 end
        end
    end)
end

