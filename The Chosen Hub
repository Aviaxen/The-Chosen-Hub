getgenv().MasterExecutionRoute = function(player)
    if player == LocalPlayer then return end
    
    if getgenv().EspConnections[player.Name] then
        getgenv().EspConnections[player.Name]:Disconnect()
        getgenv().EspConnections[player.Name] = nil
    end
    
    local function routeLoad(character)
        if not character then return end
        if getgenv().AddPlayerBoxesAndText then getgenv().AddPlayerBoxesAndText(player, character) end
        if getgenv().AddPlayerTracers then getgenv().AddPlayerTracers(player, character) end
    end
    
    if player.Character then task.spawn(routeLoad, player.Character) end
    getgenv().EspConnections[player.Name] = player.CharacterAdded:Connect(routeLoad)
end

